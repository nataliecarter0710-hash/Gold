# Copy to Render environment settings (or a local, ignored .env file). Never commit credentials.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the project secret/service-role key only in this server-side service. Never use a browser key here.
SUPABASE_SECRET_KEY=
# Alternative to SUPABASE_SECRET_KEY if your project still labels this as the project secret key:
# SUPABASE_SERVICE_ROLE_KEY=
# A separate, high-entropy shared API bearer token. Required for write endpoints.
SIM_API_TOKEN=
# Comma-separated exact browser origins. Leave empty when no browser client calls this API.
ALLOWED_ORIGINS=
# Dedicated PostgreSQL configuration for schema diagnostics only.
# Both values are required before diagnostic DB inspection is enabled.
DIAGNOSTIC_DB_ENABLED=true
DIAGNOSTIC_READONLY_DATABASE_URL=postgresql://<diagnostic-readonly-role>:<password>@<host>:5432/<database>
# TLS verification is enabled by default; only set to false for an explicitly trusted local database.
PGSSL_REJECT_UNAUTHORIZED=true
