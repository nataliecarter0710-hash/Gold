# Copy to Render environment settings (or a local, ignored .env file). Never commit credentials.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the project secret/service-role key only in this server-side service. Never use a browser key here.
SUPABASE_SECRET_KEY=
# Alternative to SUPABASE_SECRET_KEY if your project still labels this as the service-role key:
# SUPABASE_SERVICE_ROLE_KEY=
# A separate, high-entropy shared API bearer token. Required for all write endpoints.
SIM_API_TOKEN=
# Comma-separated exact browser origins. Leave empty when no browser client calls this API.
ALLOWED_ORIGINS=
# Optional direct PostgreSQL connection string used only by the schema:check script.
# Prefer a Supabase pooler connection string and keep it in local/Render secrets, never source control.
DATABASE_URL=
# TLS verification is enabled by default; only set to false for an explicitly trusted local database.
PGSSL_REJECT_UNAUTHORIZED=true
