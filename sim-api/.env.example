# Diagnostic-only staging example. Do not add real credentials or commit .env files.
# The diagnostic process is disabled unless deliberately enabled in secret runtime settings.
DIAGNOSTIC_DB_ENABLED=false
# When enabled, use a dedicated login role with no role memberships, no RLS bypass,
# no database/schema create or temporary privileges, no function EXECUTE privileges,
# and SELECT only on the four approved diagnostic tables.
DIAGNOSTIC_READONLY_DATABASE_URL=
# TLS certificate verification is mandatory and always enabled by the diagnostic code.
